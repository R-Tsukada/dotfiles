{
  "name": "quick-find",
  "displayName": "Quick Find",
  "publisher": "local",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:quickFind.open",
    "onCommand:quickFind.grep"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quickFind.open",
        "title": "ファイルをあいまい検索（プレビュー付き）"
      },
      {
        "command": "quickFind.grep",
        "title": "ファイル内の単語検索（プレビュー付き）"
      }
    ]
  }
}