{
    "claudeCode.preferredLocation": "panel",
    "emmet.preferences": {

    },
    "workbench.diffEditorAssociations": {
        "*.pdf": "pdf-preview-next.preview"
    },
    "workbench.colorTheme": "GitHub Blue",
    "git.autofetch": true,
    "claudeCode.hideOnboarding": true,
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "o", "q"],
            "commands": ["quickMemo.open"]
        },
        {
            "before": ["<leader>", "f", "f"],
            "commands": ["quickFind.open"]
        },
        {
            "before": ["<leader>", "f", "g"],
            "commands": ["quickFind.grep"]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "o", "n"],
            "commands": ["extractToNote.run"]
        }
    ]
}